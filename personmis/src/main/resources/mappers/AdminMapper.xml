<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ch.personmis.repository.AdminRepository">
	<!--
	  管理员/用户登录 Mapper
	  功能说明：根据用户名/密码查询用户，用于登录校验（命中则登录成功）
	-->
	<select id="login"  resultType="UserEntity" parameterType="UserEntity">
		select * from ausertable where aname =  #{uname} and apwd = #{upwd}
	</select>
</mapper>